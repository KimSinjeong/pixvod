+// Render normals (camera-space) for all submeshes
+void PTexMesh::RenderNormals(
+    const pangolin::OpenGlRenderState& cam,
+    const Eigen::Vector4f& clipPlane) {
+  for (size_t i = 0; i < meshes.size(); i++) {
+    Mesh& mesh = *meshes[i];
+
+    glPushAttrib(GL_POLYGON_BIT);
+    int currFrontFace;
+    glGetIntegerv(GL_FRONT_FACE, &currFrontFace);
+    glFrontFace(currFrontFace == GL_CW ? GL_CCW : GL_CW);
+
+    normalShader.Bind();
+    normalShader.SetUniform("MVP", cam.GetProjectionModelViewMatrix());
+    normalShader.SetUniform("MV", cam.GetModelViewMatrix());
+    normalShader.SetUniform("clipPlane", clipPlane(0), clipPlane(1), clipPlane(2), clipPlane(3));
+
+    mesh.vbo.Bind();
+    glVertexAttribPointer(0, mesh.vbo.count_per_element, mesh.vbo.datatype, GL_FALSE, 0, 0);
+    glEnableVertexAttribArray(0);
+    mesh.vbo.Unbind();
+
+    if (mesh.nbo.IsValid()) {
+      mesh.nbo.Bind();
+      glVertexAttribPointer(1, mesh.nbo.count_per_element, mesh.nbo.datatype, GL_FALSE, 0, 0);
+      glEnableVertexAttribArray(1);
+      mesh.nbo.Unbind();
+    }
+
+    mesh.ibo.Bind();
+    glDrawElements(GL_QUADS, mesh.ibo.num_elements, mesh.ibo.datatype, 0);
+    mesh.ibo.Unbind();
+
+    glDisableVertexAttribArray(0);
+    if (mesh.nbo.IsValid()) glDisableVertexAttribArray(1);
+
+    normalShader.Unbind();
+
+    glPopAttrib();
+  }
+}
