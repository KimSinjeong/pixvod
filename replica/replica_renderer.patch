diff --git a/ReplicaSDK/shaders/mesh-normal.vert b/ReplicaSDK/shaders/mesh-normal.vert
new file mode 100644
index 0000000..a7e5b8d
--- /dev/null
+++ b/ReplicaSDK/shaders/mesh-normal.vert
@@ -0,0 +1,20 @@
+// Copyright (c) Facebook, Inc. and its affiliates. All Rights Reserved
+#version 430 core
+
+layout(location = 0) in vec4 position;
+layout(location = 1) in vec4 normal;
+
+uniform mat4 MV, MVP;
+uniform vec4 clipPlane;
+
+out vec3 n_cam;
+
+void main()
+{
+    // Transform to camera space (RDF convention)
+    n_cam = normalize((MV * vec4(normal.xyz, 0.0)).xyz);
+    gl_ClipDistance[0] = dot(position, clipPlane);
+    gl_Position = MVP * position;
+}
+
+
