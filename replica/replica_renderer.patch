+std::vector<Eigen::Matrix4d> loadTrajectory(const std::string& filename) {
+    std::vector<Eigen::Matrix4d> trajectory;
+    std::ifstream file(filename);
+    if (!file.is_open()) {
+        std::cerr << "Error: Could not open trajectory file: " << filename << std::endl;
+        return trajectory;
+    }
+
+    std::string line;
+    while (std::getline(file, line)) {
+        std::stringstream ss(line);
+        Eigen::Matrix4d pose;
+        for (int i = 0; i < 4; ++i) {
+            for (int j = 0; j < 4; ++j) {
+                ss >> pose(i, j);
+            }
+        }
+        // NICE-SLAM exports camera-to-world transforms (T_wc).
+        // Pangolin's model-view expects world-to-camera (T_cw).
+        // Convert by inverting each pose before storing.
+        trajectory.push_back(pose.inverse());
+    }
+
+    return trajectory;
+}
+
+
+struct Intrinsics {
+  int width = 1280;
+  int height = 960;
+  double fx = 640.0;
+  double fy = 640.0;
+  double cx = (1280 - 1) / 2.0;
+  double cy = (960 - 1) / 2.0;
+  bool fromFov = false; // true if parsed via FoV format
+};
+
+static bool loadIntrinsicsFile(const std::string& filename, Intrinsics& I) {
+  std::ifstream f(filename);
+  if(!f.is_open()) return false;
+
+  // First line: W H
+  int W = 0, H = 0;
+  if(!(f >> W >> H)) return false;
+
+  // Try to read the rest of the line type
+  std::string secondLine;
+  std::getline(f, secondLine); // consume end of first line
+  if(!std::getline(f, secondLine)) return false;
+
+  std::stringstream ss(secondLine);
+
+  // Heuristic: if it begins with a letter, treat as FoV format; else try 9 numbers (K)
+  if(std::isalpha(ss.peek())) {
+    std::string fovType;
+    double fovDeg = 0.0;
+    ss >> fovType >> fovDeg;
+    double fovRad = fovDeg * M_PI / 180.0;
+    double cx = (W - 1) / 2.0;
+    double cy = (H - 1) / 2.0;
+    double fx = 0.0, fy = 0.0;
+    if(fovType != "vertical" && fovType != "horizontal") {
+      fovType = "horizontal"; // default
+    }
+    if(fovType == "horizontal") {
+      fx = cx / std::tan(fovRad * 0.5);
+      fy = fx; // square pixels
+    } else { // vertical
+      fy = cy / std::tan(fovRad * 0.5);
+      fx = fy;
+    }
+    I.width = W; I.height = H;
+    I.fx = fx; I.fy = fy; I.cx = cx; I.cy = cy;
+    I.fromFov = true;
+    return true;
+  } else {
+    // Try 9 numbers (row-major K)
+    double k11,k12,k13,k21,k22,k23,k31,k32,k33;
+    ss.clear();
+    ss.str(secondLine);
+    if(!(ss >> k11 >> k12 >> k13 >> k21 >> k22 >> k23 >> k31 >> k32 >> k33)) {
+      return false;
+    }
+    I.width = W; I.height = H;
+    I.fx = k11; I.fy = k22; I.cx = k13; I.cy = k23;
+    I.fromFov = false;
+    return true;
+  }
+}
 
