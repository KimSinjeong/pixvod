new file mode 100644
index 0000000..9cdc2b4
--- /dev/null
+++ b/ReplicaSDK/shaders/mesh-normal.frag
@@ -0,0 +1,16 @@
+// Copyright (c) Facebook, Inc. and its affiliates. All Rights Reserved
+#version 430 core
+
+layout(location = 0) out vec4 FragColor;
+
+in vec3 n_cam;
+
+void main()
+{
+    // Encode camera-space normal (RDF) into RGB in [0,1] as in typical normal maps
+    vec3 n = normalize(n_cam);
+    vec3 rgb = 0.5 * (n + vec3(1.0));
+    FragColor = vec4(rgb, 1.0f);
+}
